# =========================================================
# MultiAgent Business Insights Copilot - Environment Config
# =========================================================

# LLM Provider Configuration
# Set OPENAI_API_KEY or configure a local/alternative OpenAI-compatible endpoint (like Ollama or vLLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Models
ROUTER_MODEL=gpt-4o-mini
SQL_MODEL=gpt-4o-mini
RAG_MODEL=gpt-4o-mini
SYNTHESIS_MODEL=gpt-4o

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Set to 'sentence-transformers' for free local embeddings or 'openai' for text-embedding-3-small
EMBEDDING_PROVIDER=sentence-transformers

# MySQL Database Configuration
# Read-Write User (for setup and migrations)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=business_copilot
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_USER=copilot_user
MYSQL_PASSWORD=copilot_pass

# MySQL Read-Only User (enforced by Text-to-SQL Agent for safety)
MYSQL_READONLY_USER=copilot_readonly
MYSQL_READONLY_PASSWORD=readonly_pass

# Vector Store Path
FAISS_INDEX_PATH=data/faiss_index

# API Server & UI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000
STREAMLIT_PORT=8501

